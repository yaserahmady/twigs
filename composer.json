{
  "name": "esheep/twigs",
  "description": "A framework-agnostic Twig extension that bundles useful functions, filters, and tags into a single entry point.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "twig",
    "html",
    "cva",
    "tailwind",
    "tailwind-merge"
  ],
  "authors": [
    {
      "name": "eSheep"
    }
  ],
  "require": {
    "php": ">=8.1",
    "twig/twig": "^3.13",
    "twig/html-extra": "^3.0",
    "tales-from-a-dev/tailwind-merge-php": "^0.2",
    "yiisoft/arrays": "^3.0",
    "yiisoft/html": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "eSheep\\Twigs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "eSheep\\Twigs\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
